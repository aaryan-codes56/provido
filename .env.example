# Clerk — https://dashboard.clerk.com
# Create a free application, then copy these from the "API Keys" page.
# The publishable key is safe to expose to the browser (NEXT_PUBLIC_ prefix).
# The secret key must NEVER be committed or sent to the client.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk redirects after sign-in / sign-up. These match the routes we're
# about to create at src/app/sign-in and src/app/sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
