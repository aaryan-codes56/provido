# Clerk — https://dashboard.clerk.com
# Create a free application, then copy these from the "API Keys" page.
# The publishable key is safe to expose to the browser (NEXT_PUBLIC_ prefix).
# The secret key must NEVER be committed or sent to the client.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk redirects after sign-in / sign-up. These match the routes we're
# about to create at src/app/sign-in and src/app/sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# PostgreSQL connection string. Locally this points at a Homebrew-installed
# Postgres; in production, use your Neon/Railway connection string.
DATABASE_URL=postgresql://user@localhost:5432/provido_dev

# Stripe (test mode) — https://dashboard.stripe.com/test/apikeys
# Never use live keys in this project.
STRIPE_SECRET_KEY=

# Only obtainable by running `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# (Stripe CLI) — it prints a whsec_... value for local development.
STRIPE_WEBHOOK_SECRET=

# Used to build absolute redirect URLs for Stripe Checkout's success/cancel pages.
NEXT_PUBLIC_APP_URL=http://localhost:3000
